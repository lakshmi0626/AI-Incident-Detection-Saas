# IncidentIQ Environment Variables Configuration

# Server & Security
SECRET_KEY=incidentiq-super-secret-production-encryption-key-32bytes!
DATABASE_URL=sqlite:///./incidentiq.db
# For PostgreSQL migration:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/incidentiq

# AI Provider API Keys (Optional: Intelligent heuristic fallback active if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Telemetry Simulator
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=10

# Retention Defaults
DEFAULT_LOGS_RETENTION_DAYS=30
DEFAULT_METRICS_RETENTION_DAYS=90
DEFAULT_TRACES_RETENTION_DAYS=14
